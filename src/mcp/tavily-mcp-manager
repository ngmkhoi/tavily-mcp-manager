#!/usr/bin/env bash
set -euo pipefail

# Resolve symlink to find real script directory
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

tavily_home="${TAVILY_HOME:-$HOME/.tavily-mcp-manager}"
keys_file="${TAVILY_KEYS_FILE:-$tavily_home/keys.env}"
config_file="${TAVILY_CONFIG_FILE:-$tavily_home/config.json}"
legacy_active_file="${TAVILY_ACTIVE_FILE:-$tavily_home/active-key}"
# Deliberately not under /tmp: macOS prunes files there that have not been
# accessed for a few days, which silently guts the dependency tree and leaves
# a cache that looks installed but cannot start.
npm_cache="${TAVILY_NPM_CACHE:-$tavily_home/npm-cache}"
tavily_mcp_version="${TAVILY_MCP_VERSION:-0.2.19}"
tavily_mcp_package="${TAVILY_MCP_PACKAGE:-tavily-mcp@$tavily_mcp_version}"
repo_root="$(cd "$SCRIPT_DIR/../.." && pwd)"

cache_bin="$npm_cache/node_modules/.bin/tavily-mcp"
cache_stamp="$npm_cache/.tavily-mcp-installed"

# legacy_active_file is consumed by store(), defined in the sourced module.
# shellcheck source=src/cli/store.sh
source "$SCRIPT_DIR/../cli/store.sh"

# A present .bin symlink proves nothing: it survives even when every package
# it points into has been pruned. Verify that the package tree is actually
# intact and that it holds the version we pinned.
cache_is_healthy() {
  [[ -x "$cache_bin" ]] || return 1
  [[ -f "$cache_stamp" ]] || return 1
  [[ "$(cat "$cache_stamp" 2>/dev/null)" == "$tavily_mcp_package" ]] || return 1

  TAVILY_CACHE_ROOT="$npm_cache" node -e '
const fs = require("node:fs");
const path = require("node:path");
const root = path.join(process.env.TAVILY_CACHE_ROOT, "node_modules");

// Every installed package must still have a readable package.json. That file
// carries the "exports" map, so a package missing it breaks subpath imports
// with ERR_MODULE_NOT_FOUND even though the directory still exists.
function check(dir) {
  for (const entry of fs.readdirSync(dir)) {
    if (entry.startsWith(".")) continue;
    const full = path.join(dir, entry);
    if (entry.startsWith("@")) {
      if (fs.statSync(full).isDirectory()) check(full);
      continue;
    }
    if (!fs.statSync(full).isDirectory()) continue;
    if (!fs.existsSync(path.join(full, "package.json"))) {
      process.exit(1);
    }
  }
}

try {
  if (!fs.existsSync(root)) process.exit(1);
  check(root);
  require.resolve("tavily-mcp/package.json", { paths: [process.env.TAVILY_CACHE_ROOT] });
} catch {
  process.exit(1);
}
' >/dev/null 2>&1 || return 1

  return 0
}

install_mcp() {
  local reason="$1"

  # Guard the rm below: an empty or root cache path must never be walked.
  if [[ -z "$npm_cache" || "$npm_cache" == "/" ]]; then
    echo "[tavily-mcp] refusing to use '$npm_cache' as the npm cache path" >&2
    return 1
  fi

  echo "[tavily-mcp] $reason — installing $tavily_mcp_package into $npm_cache ..." >&2
  rm -rf "$npm_cache/node_modules" "$cache_stamp"
  mkdir -p "$npm_cache"

  local log
  log="$(npm install --prefix "$npm_cache" --no-audit --no-fund "$tavily_mcp_package" 2>&1)" || {
    echo "[tavily-mcp] install failed:" >&2
    printf '%s\n' "$log" | tail -20 >&2
    return 1
  }

  printf '%s' "$tavily_mcp_package" > "$cache_stamp"
}

ensure_mcp_cached() {
  if cache_is_healthy; then
    return 0
  fi

  local reason="First run"
  if [[ -e "$cache_bin" ]]; then
    if [[ -f "$cache_stamp" && "$(cat "$cache_stamp" 2>/dev/null)" != "$tavily_mcp_package" ]]; then
      reason="Cached $(cat "$cache_stamp" 2>/dev/null) does not match requested $tavily_mcp_package"
    else
      reason="Cached install is incomplete or corrupted"
    fi
  fi

  install_mcp "$reason"
}

resolve_and_exec_mcp() {
  if cache_is_healthy; then
    exec "$cache_bin" "$@"
  fi

  # Opt-in escape hatch: a globally installed tavily-mcp is not version-checked,
  # so it is only used when the pinned cache could not be prepared.
  if [[ "${TAVILY_MCP_ALLOW_GLOBAL:-0}" == "1" ]] && command -v tavily-mcp >/dev/null 2>&1; then
    echo "[tavily-mcp] WARNING: falling back to the global tavily-mcp on PATH; its version is not verified against $tavily_mcp_package." >&2
    exec tavily-mcp "$@"
  fi

  echo "[tavily-mcp] WARNING: no usable cache; falling back to 'npm exec', which downloads on every start." >&2
  exec npm exec --yes --package "$tavily_mcp_package" -- tavily-mcp "$@"
}

# Internal hook so the test suite can exercise the real verification logic
# instead of a copy of it that could drift.
if [[ "${1:-}" == "--verify-cache" ]]; then
  cache_is_healthy
  exit $?
fi

if [[ "${TAVILY_AUTO_ROTATE:-0}" == "1" ]]; then
  # Startup rotation reads through the usage cache. Explicit `tavily-manager
  # usage` calls still go to the API, so the numbers a human asks for are live.
  TAVILY_USAGE_TIMEOUT_SECONDS="${TAVILY_USAGE_STARTUP_TIMEOUT_SECONDS:-2}" \
  TAVILY_USAGE_USE_CACHE="${TAVILY_USAGE_USE_CACHE:-1}" \
    "$repo_root/src/cli/tavily-manager" rotate \
    --min-remaining "${TAVILY_ROTATE_THRESHOLD_PERCENT:-${TAVILY_USAGE_WARNING_PERCENT:-5}}" \
    --only-if-current-below "${TAVILY_ROTATE_THRESHOLD_PERCENT:-${TAVILY_USAGE_WARNING_PERCENT:-5}}" >&2 || true
else
  "$repo_root/src/cli/tavily-manager" current >/dev/null
fi

if [[ ! -r "$keys_file" ]]; then
  echo "Missing Tavily key file: $keys_file" >&2
  exit 1
fi

if [[ ! -r "$config_file" ]]; then
  echo "Missing Tavily config file: $config_file" >&2
  exit 1
fi

active_env_var="$(
  TAVILY_CONFIG_FILE_PATH="$config_file" node -e '
const fs = require("node:fs");
const config = JSON.parse(fs.readFileSync(process.env.TAVILY_CONFIG_FILE_PATH, "utf8"));
const activeKey = config.activeKey;
const record = activeKey && config.keys ? config.keys[activeKey] : null;
if (!record || !record.envVar) {
  console.error("No active Tavily key configured. Use: tavily-manager add <api-key>");
  process.exit(1);
}
console.log(record.envVar);
'
)"

# Read the secret through the store rather than sourcing keys.env, so a key
# value can never be interpreted as shell syntax.
tavily_api_key="$(store get 2>/dev/null || true)"
if [[ -z "$tavily_api_key" ]]; then
  echo "Tavily key '$active_env_var' is empty or missing in $keys_file" >&2
  exit 1
fi

export TAVILY_API_KEY="$tavily_api_key"
export npm_config_cache="$npm_cache"
export npm_config_audit="${npm_config_audit:-false}"
export npm_config_fund="${npm_config_fund:-false}"

if [[ "${TAVILY_USAGE_STARTUP_CHECK:-0}" != "0" ]]; then
  usage_json="$(curl --fail --silent --show-error \
    --max-time "${TAVILY_USAGE_STARTUP_TIMEOUT_SECONDS:-2}" \
    --request GET \
    --url "https://api.tavily.com/usage" \
    --header "Authorization: Bearer ${TAVILY_API_KEY}" 2>/dev/null || true)"

  if [[ -n "$usage_json" ]]; then
    TAVILY_USAGE_RESPONSE="$usage_json" node -e '
const data = JSON.parse(process.env.TAVILY_USAGE_RESPONSE || "{}");
const warningPercent = Number(process.argv[1] || 5);
const envVar = process.argv[2] || "unknown";
const key = data.key || {};
const account = data.account || {};
const keyUsed = typeof key.usage === "number" ? key.usage : 0;
const keyLimit = typeof key.limit === "number" ? key.limit : 0;
const accountUsed = (typeof account.plan_usage === "number" ? account.plan_usage : 0) + (typeof account.paygo_usage === "number" ? account.paygo_usage : 0);
const accountLimit = (typeof account.plan_limit === "number" ? account.plan_limit : 0) + (typeof account.paygo_limit === "number" ? account.paygo_limit : 0);
const used = keyLimit > 0 ? keyUsed : accountUsed;
const limit = keyLimit > 0 ? keyLimit : accountLimit;
const scope = keyLimit > 0 ? "key" : "account";

if (limit > 0) {
  const remaining = Math.max(0, limit - used);
  const remainingPct = (remaining / limit) * 100;
  if (remainingPct <= warningPercent) {
    console.error(
      `[tavily-mcp] WARNING: active key ${envVar} has low ${scope} credits: ${remaining}/${limit} remaining (${remainingPct.toFixed(1)}%). Switch with: tavily-manager switch <slot|alias>`
    );
  }
}
' "${TAVILY_USAGE_WARNING_PERCENT:-5}" "$active_env_var" >&2 || true
  fi
fi

ensure_mcp_cached || true
resolve_and_exec_mcp "$@"
