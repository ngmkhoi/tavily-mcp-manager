#!/usr/bin/env bash
set -euo pipefail

# Resolve symlink to find real script directory
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

tavily_home="${TAVILY_HOME:-$HOME/.tavily-mcp-manager}"
keys_file="${TAVILY_KEYS_FILE:-$tavily_home/keys.env}"
config_file="${TAVILY_CONFIG_FILE:-$tavily_home/config.json}"
legacy_active_file="${TAVILY_ACTIVE_FILE:-$tavily_home/active-key}"
repo_root="$(cd "$SCRIPT_DIR/../.." && pwd)"

# shellcheck source=src/cli/ui.sh
source "$SCRIPT_DIR/ui.sh"
# shellcheck source=src/cli/store.sh
source "$SCRIPT_DIR/store.sh"
# shellcheck source=src/cli/keys.sh
source "$SCRIPT_DIR/keys.sh"
# shellcheck source=src/cli/usage.sh
source "$SCRIPT_DIR/usage.sh"
# shellcheck source=src/cli/mcp-config.sh
source "$SCRIPT_DIR/mcp-config.sh"

usage() {
  {
    headline
    section_title "Commands"
    printf '  %s\n' "${bold}Key setup${reset}"
    printf '    %-30s %s\n' "init" "create local storage"
    printf '    %-30s %s\n' "add <api-key> [--alias <label>]" "save a new Tavily key"
    printf '    %-30s %s\n' "switch <slot|alias>" "make a key active"
    printf '    %-30s %s\n' "current" "show the active key"
    printf '    %-30s %s\n' "list" "show saved keys"
    printf '\n'
    printf '  %s\n' "${bold}Maintenance${reset}"
    printf '    %-30s %s\n' "key add <api-key> [--alias <label>]" "save a new Tavily key"
    printf '    %-30s %s\n' "key rename <slot|alias> <alias>" "rename an alias"
    printf '    %-30s %s\n' "key remove <slot|alias>" "remove a key"
    printf '    %-30s %s\n' "usage [current|all|slot|alias]" "check credits"
    printf '    %-30s %s\n' "rotate [options]" "switch to the key with most credits"
    printf '\n'
    printf '  %s\n' "${bold}MCP${reset}"
    printf '    %-30s %s\n' "doctor" "check local setup"
    printf '    %-30s %s\n' "mcp status" "show wrapper runtime status"
    printf '    %-30s %s\n' "mcp install <agent|all>" "register tavily with an agent"
    printf '    %-30s %s\n' "mcp config <agent>" "print config to paste manually"
    printf '    %-30s %s\n' "mcp config list" "show supported agents"
    printf '\n'
    printf '  %s\n' "${dim}Agents: codex, claude, gemini, opencode${reset}"
    printf '  %s\n' "${dim}Install options: --dry-run --force${reset}"
    printf '  %s\n' "${dim}Rotate options: --dry-run --min-remaining <percent> --only-if-current-below <percent>${reset}"
  } >&2
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

command="$1"
shift || true

if [[ "$command" == "key" ]]; then
  command="${1:-}"
  shift || true
fi

case "$command" in
  init)
    init_store
    ;;
  doctor)
    doctor
    ;;
  mcp)
    mcp_command="${1:-}"
    shift || true
    case "$mcp_command" in
      status)
        mcp_status
        ;;
      install)
        mcp_install "$@"
        ;;
      config)
        case "${1:-}" in
          codex)
            mcp_config_codex
            ;;
          claude)
            mcp_config_claude
            ;;
          gemini)
            mcp_config_gemini
            ;;
          opencode)
            mcp_config_opencode
            ;;
          list)
            mcp_config_list
            ;;
          *)
            usage
            exit 2
            ;;
        esac
        ;;
      *)
        usage
        exit 2
        ;;
    esac
    ;;
  add)
    add_key "$@"
    ;;
  rename)
    rename_key "$@"
    ;;
  remove|rm)
    remove_key "$@"
    ;;
  current)
    show_current
    ;;
  list|ls)
    list_keys
    ;;
  usage|status)
    load_store
    target="${1:-current}"
    case "$target" in
      current)
        raw_usage="$(usage_for_key "$(current_id)")"
        render_usage "$raw_usage"
        ;;
      all)
        headline
        section_title "Usage Summary"
        printf '%-16s %-9s %8s %8s %8s %8s %s\n' "Key" "Scope" "Used" "Limit" "Remain" "Left" "Status"
        printf '%-16s %-9s %8s %8s %8s %8s %s\n' "----------------" "---------" "--------" "--------" "--------" "--------" "------"
        while IFS='|' read -r id _ _; do
          if raw_usage="$(usage_for_key "$id" 2>/dev/null)"; then
            usage_summary_row "$raw_usage" || true
          fi
        done < <(store list)
        print_store_paths
        ;;
      *)
        id="$(resolve_key_ref "$target")"
        raw_usage="$(usage_for_key "$id")"
        render_usage "$raw_usage"
        ;;
    esac
    ;;
  switch)
    switch_key "${1:-}"
    ;;
  rotate)
    load_store
    rotate_key "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage
    exit 2
    ;;
esac
